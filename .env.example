# Local development values only. Replace secrets before any shared deployment.
MYSQL_ROOT_PASSWORD=Venku@7474
DB_USER=courier
DB_PASSWORD=courier_dev_only
# Docker broker defaults to rabbitmq; use a dedicated native user, never guest.
# For a native Windows broker, change RABBITMQ_HOST to host.docker.internal.
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=courier
RABBITMQ_PASSWORD=courier_dev_only
RABBITMQ_PORT=5672
JWT_SECRET=local_dev_secret_change_me_32_chars_minimum
JWT_EXPIRATION_MS=86400000
SHIPMENT_SERVICE_URL=http://shipment-service:5002
USER_SERVICE_URL=http://user-service:5001
TRACKING_SERVICE_URL=http://tracking-service:5003
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_GENERAL=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_WINDOW_SECONDS=60
